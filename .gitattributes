# Development-only files, left out of GitHub's release archives (what GPM installs)
# and of `git archive`. admin-next/ stays: Admin2 loads the field from it at runtime.
.github         export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.yamllint       export-ignore
phpstan.neon    export-ignore
tests           export-ignore
CLAUDE.md       export-ignore
PLAN.md         export-ignore
docs/agents     export-ignore
